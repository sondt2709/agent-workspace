{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AW task.yaml",
  "$comment": "Generated by `pnpm schema:generate` from shared/schema/src. Do not edit.",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "const": "task" },
    "schema": { "type": "number", "const": 1 },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}-[1-9]\\d*$" },
    "project": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "first_message": { "type": "string" },
    "stage": {
      "type": "string",
      "enum": ["backlog", "discuss", "ready", "implement", "review", "done"]
    },
    "needs_you": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      }
    },
    "paused": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "cause": {
              "type": "string",
              "enum": [
                "usage_limit",
                "usage_limit_weekly",
                "continue_cap",
                "device_offline",
                "device_restart",
                "device_revoked",
                "network_lost",
                "waiting_for_sync",
                "task_moving",
                "agent_error",
                "login_expired"
              ]
            },
            "since": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "resumes_at": {
              "default": null,
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                { "type": "null" }
              ]
            },
            "next_step": { "type": "string", "minLength": 1 },
            "needs_human": { "type": "boolean" }
          },
          "required": ["cause", "since", "next_step", "needs_human"],
          "additionalProperties": {}
        },
        { "type": "null" }
      ]
    },
    "assignee": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "maxLength": 127,
          "pattern": "^[a-z][a-z0-9-]*@[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        { "type": "null" }
      ]
    },
    "claim": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "device": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "session": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
            }
          },
          "required": ["epoch", "device", "session"],
          "additionalProperties": {}
        },
        { "type": "null" }
      ]
    },
    "approach": {
      "default": { "latest": 0, "confirmed": null },
      "type": "object",
      "properties": {
        "latest": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "confirmed": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        }
      },
      "required": ["latest", "confirmed"],
      "additionalProperties": {}
    },
    "ready": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "passed_on": {
              "anyOf": [
                { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                { "type": "null" }
              ]
            },
            "missing": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["passed_on", "missing"],
          "additionalProperties": {}
        },
        { "type": "null" }
      ]
    },
    "test_server": {
      "default": null,
      "anyOf": [
        { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(?:[-_.][a-z0-9]+)*$" },
        { "type": "null" }
      ]
    },
    "credentials": {
      "default": [],
      "type": "array",
      "items": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(?:[-_.][a-z0-9]+)*$" }
    },
    "parent": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
        },
        { "type": "null" }
      ]
    },
    "subtasks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      }
    },
    "depends_on": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
      }
    },
    "links": { "default": [], "type": "array", "items": { "type": "string", "minLength": 1 } },
    "branch": {
      "default": null,
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "includes": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 63,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
    },
    "archived": { "default": false, "type": "boolean" }
  },
  "required": ["kind", "schema", "id", "key", "project", "title", "first_message", "stage"],
  "additionalProperties": {}
}
