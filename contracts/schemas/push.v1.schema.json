{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AW push.yaml",
  "$comment": "Generated by `pnpm schema:generate` from shared/schema/src. Do not edit.",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "const": "push" },
    "schema": { "type": "number", "const": 1 },
    "device": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "subscriptions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "computer": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "endpoint": { "type": "string", "maxLength": 4096, "pattern": "^https?:\\/\\/\\S+$" },
          "p256dh": { "type": "string", "pattern": "^B[A-Za-z0-9_-]{86}$" },
          "auth": {
            "type": "string",
            "minLength": 16,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "vapid_public_key": { "type": "string", "pattern": "^B[A-Za-z0-9_-]{86}$" },
          "distributor": {
            "default": null,
            "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
          },
          "updated": { "default": "", "type": "string" }
        },
        "required": ["computer", "endpoint", "p256dh", "auth", "vapid_public_key"],
        "additionalProperties": {}
      }
    }
  },
  "required": ["kind", "schema", "device"],
  "additionalProperties": {}
}
