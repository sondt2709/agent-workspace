{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AW workspace.yaml",
  "$comment": "Generated by `pnpm schema:generate` from shared/schema/src. Do not edit.",
  "type": "object",
  "properties": {
    "kind": { "type": "string", "const": "workspace" },
    "schema": { "type": "number", "const": 1 },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "key_prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{0,9}$" },
    "device_order": {
      "default": [],
      "type": "array",
      "items": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "switches": {
      "default": { "community_relays": true },
      "type": "object",
      "properties": { "community_relays": { "default": true, "type": "boolean" } },
      "additionalProperties": {}
    },
    "new_project_permission_mode": {
      "default": "skip",
      "type": "string",
      "enum": ["default", "accept_edits", "skip"]
    }
  },
  "required": ["kind", "schema", "id", "name", "key_prefix"],
  "additionalProperties": {}
}
