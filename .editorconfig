root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
# Two spaces at the end of a line are a line break in Markdown.
trim_trailing_whitespace = false
max_line_length = off

[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ktlint_code_style = ktlint_official

[{*.bat,gradlew.bat}]
end_of_line = crlf

[Makefile]
indent_style = tab
