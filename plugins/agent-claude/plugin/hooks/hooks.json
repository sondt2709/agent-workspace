            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/aw-hook\" Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/aw-hook\" StopFailure",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/aw-hook\" SessionEnd",
            "timeout": 10
          }
        ]
      }
    ]
