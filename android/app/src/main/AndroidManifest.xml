<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app (docs/phase-1.md 6.7 and 10). No all-files access: the workspace files stay in
     app-private storage. The pairing screen asks for ACCESS_LOCAL_NETWORK on Android 17 (6.7.7). The
     QR scan uses the ML Kit code scanner of Play services: no camera permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- A DeX or desktop window has a mouse and a keyboard, and no touch screen
         (docs/phase-1.md 10.9). -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- No backup: the engine home has the device key and the API key of this phone. -->
    <application
        android:name=".AwApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aw">

        <!-- One adaptive activity: no screenOrientation, resizeableActivity at its default, and the
             configChanges of docs/phase-1.md 10.9, so a fold, a resize or a keyboard or mouse attach
             does not recreate it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A gate notification opens a task through this alias only. It is not exported, so only AW
             starts it; MainActivity reads the task extras only from it (owner decision Q9). -->
        <activity-alias
            android:name=".OpenFromNotification"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- One specialUse foreground service runs the sync engine (decision 2026-11-22-approved-defaults
             item 3; dataSync is limited to 6 h per 24 h on Android 15+). -->
        <service
            android:name=".SyncEngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="@string/special_use_subtype" />
        </service>

        <!-- "Open" of a downloaded artifact (openspec gate-full-context): a read-only content URI for
             one file, never exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.artifacts"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/artifact_paths" />
        </provider>

        <!-- The UnifiedPush receiver (docs/phase-1.md 8). The embedded FCM distributor declares its
             own receivers in its library manifest. -->
        <service
            android:name=".push.AwPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
