{
  "name": "@aw/desktop",
  "productName": "Agent Workspace",
  "version": "0.0.0",
  "private": true,
  "description": "The desktop app: Electron main, preload and the React + MUI renderer.",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "prettier": "@aw/config/prettier",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/renderer/tsconfig.json",
    "test": "vitest run",
    "build": "electron-vite build",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "electron:fetch": "install-electron",
    "package": "electron-vite build && node scripts/notices.ts && electron-builder --config electron-builder.yaml --mac"
  },
  "dependencies": {
    "@aw/client": "workspace:*",
    "@aw/core": "workspace:*",
    "@aw/plugin-api": "workspace:*",
    "@aw/ui": "workspace:*",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "7.0.6",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@tanstack/react-query": "5.107.1",
    "p-retry": "9.0.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.24.0",
    "react-router": "8.5.1",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aw/config": "workspace:*",
    "@electron/notarize": "3.1.2",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "electron": "45.3.2",
    "electron-builder": "26.18.1",
    "electron-vite": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
